.DS_Store
/.build
/build/
/Packages
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc
.gm/

# corpus-gen output (generated dev artifacts; not committed)
Corpus/synthetic/*.json

# Imported real labels (private session transcripts; regenerate via
# `corpus-gen --import-real`; never committed)
Corpus/real/*.json

# Generated training dataset (derived from labeled corpus; regenerate, don't commit)
Corpus/dataset/*.csv

# SwiftPM build artifacts
Tools/CorpusGenerator/.build/
.agents/skills/macos-spm-app-packaging/assets/templates/bootstrap/.build/
.superpowers/

# Git worktrees
.worktrees/

# Local Xcode wrapper used to avoid iCloud/FileProvider project-open hangs
/XcodeOpen.nosync/

# Local simulator import inbox; audio files are private and too large for Git/Xcode source control scanning
/SimulatorDrop/*.mp3
/SimulatorDrop/*.m4a
/SimulatorDrop/*.wav
/SimulatorDrop/*.aac
/SimulatorDrop/*.flac

# Local nested repos/tools; keep out of parent repo tracking
/catigorizer/
/lightMapCreationTool/

# Local raw corpus inputs and generated script corpus
/.awakeners/
/.deepeners.mp3/
/.fract/
/.inductions/
/.scripts/
/.stuff/
/ScriptCorpus/

# Generated artifacts: Python bytecode caches and the graphify knowledge-graph output (regenerable via graphify update)
__pycache__/
/graphify-out/

# Design docs and plans live in doc/ and are intentionally not tracked.
/doc/

# Coverage and SwiftPM build output that escaped the patterns above.
default.profraw
Tools/CorpusGenerator/build/

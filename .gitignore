.DS_Store
/.build
/build/
/Packages
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc
.gm/

# corpus-gen output (generated dev artifacts; not committed)
Corpus/synthetic/*.json

# Imported real labels (private session transcripts; regenerate via
# `corpus-gen --import-real`; never committed)
Corpus/real/*.json

# Generated training dataset (derived from labeled corpus; regenerate, don't commit)
Corpus/dataset/*.csv

# SwiftPM build artifacts
Tools/CorpusGenerator/.build/
.agents/skills/macos-spm-app-packaging/assets/templates/bootstrap/.build/
.superpowers/

# Git worktrees
.worktrees/

# Local Xcode wrapper used to avoid iCloud/FileProvider project-open hangs
/XcodeOpen.nosync/

# Local simulator import inbox; audio files are private and too large for Git/Xcode source control scanning
/SimulatorDrop/*.mp3
/SimulatorDrop/*.m4a
/SimulatorDrop/*.wav
/SimulatorDrop/*.aac
/SimulatorDrop/*.flac

# Local nested repos/tools; keep out of parent repo tracking
/catigorizer/
/lightMapCreationTool/

# Local raw corpus inputs and generated script corpus
/.awakeners/
/.deepeners.mp3/
/.fract/
/.inductions/
/.scripts/
/.stuff/
/ScriptCorpus/

# Generated artifacts: Python bytecode caches and the graphify knowledge-graph output (regenerable via graphify update)
__pycache__/
/graphify-out/

# Reference audio and other bulk source media.
/doc/

# Historical design docs and plans (pre-2026-08). Consolidated here from the old
# /doc/superpowers/ tree so every doc lives under docs/, but kept untracked to
# match the original "design docs are intentionally not tracked" policy — this
# repository is public. Current specs and plans under docs/superpowers/ ARE tracked.
/docs/archive/

# Coverage and SwiftPM build output that escaped the patterns above.
default.profraw
Tools/CorpusGenerator/build/

# Support site is a separate Next.js app with its own dependencies and build
# output (~760 MB); it is not part of the Xcode project.
/lumesync-support-site/

# Downloaded third-party reference PDFs (transcriptions of published audio).
# Reference material only — never committed, same policy as Corpus/real.
/Download */

# Xcode build output from the screenshot/preview pipeline. Same policy as
# DerivedData/ above; the leading dot means that pattern does not catch it.
/.derived-data/

# App Store screenshot and preview assets (~200 MB of PNGs, simulator screen
# recordings, and the rendered preview .mp4). Deliberately untracked: they are
# regenerable from the capture pipeline, and this repository is public, so the
# weight would be permanent and awkward to remove from history later. They live
# on disk and are uploaded to App Store Connect directly.
/screenshots/

# LumeLabel companion labelling app. Kept out of the public repository by
# request; the sources stay on disk locally. Nothing in the shipped app target
# depends on it — the Ilumionate scheme has no reference to it and there are no
# target dependencies on it — so removing it does not affect building the app.
/LumeLabel/
